{
  "schema": 2,
  "owner": "netchess",
  "version": "1.2.0",
  "launchers": [
    {
      "name": "NetChessZX Classic",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.classic",
      "arguments": [
        "--program", "netchess", "--target", "classic",
        "--netchess", "."
      ],
      "icon": "client/shatranj.icns"
    },
    {
      "name": "NetChessZX Next",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.next",
      "arguments": [
        "--program", "netchess", "--target", "next",
        "--netchess", "."
      ],
      "icon": "client/shatranj.icns"
    },
    {
      "name": "NetChessZX SpectraNext",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.spectranext",
      "runtime": "fusex",
      "arguments": [
        "--program",
        "spectranext",
        "--spectranext-manifest",
        "./packaging/spectranext/port.json"
      ],
      "icon": "client/shatranj.icns"
    },
    {
      "name": "NetChessZX SpectraNext Installer",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.spectranext-installer",
      "runtime": "fusex",
      "mode": "installer",
      "arguments": [
        "--program",
        "spectranext",
        "--spectranext-manifest",
        "./packaging/spectranext/port.json"
      ],
      "icon": "client/shatranj.icns"
    }
  ]
}
